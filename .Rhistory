quals <- as.numeric(readLines(file.path(vp,'quals.tmp')));
qudp <- unname(round(quantile(dps,0.99)));
ququ <- unname(quantile(quals,0.99));
write(qudp,file.path(vp,'dpt.tmp'));
write(ququ,file.path(vp,'qut.tmp'));
"

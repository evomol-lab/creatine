library(GEOquery)
## change my_id to be the dataset that you want.
my_id <- "GSE20602"
gse <- getGEO(my_id)
gse <- gse[[1]]
summary(exprs(gse))
boxplot(exprs(gse),outline=FALSE)
library(dplyr)
sampleInfo <- pData(gse)
sampleInfo
sampleInfo <- select(sampleInfo, "source_name_ch1","disease state:ch1")
View(sampleInfo)
sampleInfo <- rename(sampleInfo, "Sample"="source_name_ch1", "State"="disease state:ch1")
sampleInfo <- sampleInfo %>%
mutate(Sample = case_when(
Sample == "kidney biopsy from patient with NSC" ~ "NSC",
Sample == "kidney biopsy from patient after Tumor Nephrectomy" ~ "aTN",
TRUE ~ Sample
))
library(ggplot2)
library(ggrepel)
pca <- prcomp(t(exprs(gse)))
cbind(sampleInfo, pca$x) %>%
ggplot(aes(x = PC1, y=PC2, col=Sample,label=paste("", State))) + geom_point() + geom_text_repel()
library(GEOquery)
## change my_id to be the dataset that you want.
my_id <- "GSE6344"
gse <- getGEO(my_id)
length()gse)
length(gse)
gse1 <- gse[[1]]
gse2 <- gse[[2]]
summary(exprs(gse1))
gse2 <- gse[[2]]
summary(exprs(gse2))
boxplot(exprs(gse1),outline=FALSE)
boxplot(exprs(gse2),outline=FALSE)
exprs(gse1) <- log2(exprs(gse1))
exprs(gse2) <- log2(exprs(gse2))
boxplot(exprs(gse1),outline=FALSE)
boxplot(exprs(gse2),outline=FALSE)
summary(exprs(gse1))
summary(exprs(gse2))
library(dplyr)
sampleInfo <- pData(gse1)
View(sampleInfo)
library(dplyr)
sampleInfo2 <- pData(gse1)
View(sampleInfo2)
sampleInfo <- select(sampleInfo, "title","characteristics_ch1")
sampleInfo2 <- select(sampleInfo2, "title","characteristics_ch1")
View(sampleInfo2)
sampleInfo <- rename(sampleInfo, "Sample"="title", "State"="characteristics_ch1")
sampleInfo2 <- rename(sampleInfo2, "Sample"="title", "State"="characteristics_ch1")
library(dplyr)
sampleInfo2 <- pData(gse2)
sampleInfo2 <- select(sampleInfo2, "title","characteristics_ch1")
sampleInfo2 <- rename(sampleInfo2, "Sample"="title", "State"="characteristics_ch1")
sampleInfo2$Sample <- gsub("(HG-U133B)", "", sampleInfo$Sample)
sampleInfo2$Sample <- gsub("(HG-U133B)", "", sampleInfo2$Sample)
sampleInfo2$Sample <- gsub("", "(HG-U133B)", sampleInfo2$Sample)
clearPushBack()
library(GEOquery)
## change my_id to be the dataset that you want.
my_id <- "GSE6344"
gse <- getGEO(my_id)
length(gse)
gse1 <- gse[[1]]
gse2 <- gse[[2]]
exprs(gse1) <- log2(exprs(gse1))
exprs(gse2) <- log2(exprs(gse2))
boxplot(exprs(gse1),outline=FALSE)
boxplot(exprs(gse2),outline=FALSE)
library(dplyr)
sampleInfo1 <- pData(gse1)
View(sampleInfo1)
sampleInfo2 <- pData(gse2)
View(sampleInfo2)
sampleInfo1 <- select(sampleInfo1, "title","characteristics_ch1")
sampleInfo2 <- select(sampleInfo2, "title","characteristics_ch1")
sampleInfo2 <- rename(sampleInfo2, "Sample"="title", "State"="characteristics_ch1")
sampleInfo1 <- select(sampleInfo1, "title","characteristics_ch1")
sampleInfo1$Sample <- sub("Stage 1.*", "Stage1", sampleInfo1$Sample)
sampleInfo1$Sample <- ifelse(grepl("Stage 1", sampleInfo1$Sample), "Stage1", sampleInfo1$Sample)
library(GEOquery)
## change my_id to be the dataset that you want.
my_id <- "GSE6344"
gse <- getGEO(my_id)
length(gse)
gse1 <- gse[[1]]
gse2 <- gse[[2]]
exprs(gse1) <- log2(exprs(gse1))
exprs(gse2) <- log2(exprs(gse2))
boxplot(exprs(gse1),outline=FALSE)
boxplot(exprs(gse2),outline=FALSE)
library(dplyr)
sampleInfo1 <- pData(gse1)
sampleInfo2 <- pData(gse2)
sampleInfo1 <- select(sampleInfo1, "title","characteristics_ch1")
sampleInfo2 <- select(sampleInfo2, "title","characteristics_ch1")
sampleInfo2 <- rename(sampleInfo2, "Sample"="title", "State"="characteristics_ch1")
sampleInfo1 <- rename(sampleInfo1, "Sample"="title", "State"="characteristics_ch1")
View(sampleInfo1)
View(sampleInfo2)
sampleInfo1$Sample <- sub(",.*", "", sampleInfo1$Sample)
sampleInfo1$State <- sub(",.*", "", sampleInfo1$State)
sampleInfo2$Sample <- sub(",.*", "", sampleInfo2$Sample)
sampleInfo2$State <- sub(",.*", "", sampleInfo2$State)
library(pheatmap)
corMatrix <- cor(exprs(gse1),use="c")
pheatmap(corMatrix)
corMatrix <- cor(exprs(gse2),use="c")
pheatmap(corMatrix)
pheatmap(corMatrix,
annotation_col=sampleInfo1)
pheatmap(corMatrix,
annotation_col=sampleInfo2)
corMatrix1 <- cor(exprs(gse1),use="c")
pheatmap(corMatrix1)
corMatrix1 <- cor(exprs(gse1),use="c")
pheatmap(corMatrix1)
corMatrix2 <- cor(exprs(gse2),use="c")
pheatmap(corMatrix2)
View(corMatrix2)
pheatmap(corMatrix1,
annotation_col=sampleInfo1)

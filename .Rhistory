dps <- as.numeric(readLines(file.path("/media", "jpmslima", "home2", "WES", "UFCanalysis", "vcf", "dps.tmp")));
quals <- as.numeric(readLines(file.path("/media", "jpmslima", "home2", "WES", "UFCanalysis", "vcf", "quals.tmp")));
qudp <- unname(round(quantile(dps,0.99)));
ququ <- unname(quantile(quals,0.99));
write(qudp, file.path("/media", "jpmslima", "home2", "WES", "UFCanalysis", "vcf", "dpt.tmp"));
write(ququ, file.path("/media", "jpmslima", "home2", "WES", "UFCanalysis", "vcf", "qut.tmp"));
